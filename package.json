{
  "name": "crimtane",
  "version": "3.0.0",
  "scripts": {
    "deploy": "sass src/main.scss dist/styles.css --style=compressed && node src/js/generate-import.js",

    "main": "sass src/main.scss dist/styles.css --style=compressed",
    "generate-import": "node src/js/generate-import.js",

    "reset": "rm -r ../strawberry-pie/public/stylesheet && mkdir ../strawberry-pie/public/stylesheet",
    "dev": "mv dist ../strawberry-pie/public/stylesheet/",
    "test": "npm run reset && npm run deploy && npm run dev"
  },
  "devDependencies": {
    "sass": "^1.32.0"
  }
}
